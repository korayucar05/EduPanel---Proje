{
  "firestore": [
    {
      "database": "ai-studio-edupanel-4b57bdb2-6b51-496b-bb79-bf5ec9de221f",
      "rules": "firestore.rules"
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/s/**/manifest.webmanifest",
        "destination": "/manifest.webmanifest"
      },
      {
        "source": "/t/**/manifest.webmanifest",
        "destination": "/manifest.webmanifest"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
