import React from "react";
import { motion, AnimatePresence } from "motion/react";
import {
  Users,
  GraduationCap,
  BookOpen,
  Percent,
  TrendingUp,
  Award,
  ArrowUpRight,
  Megaphone,
  Bell,
  Activity,
  Calendar,
  Clock,
  Trash2,
  Plus,
  Pencil,
  Check,
  Play,
  Pause,
  ChevronUp,
  ChevronDown,
  ChevronLeft,
  ChevronRight,
  Settings,
  Cake,
  Sparkles,
  Star,
  UserCheck,
  X,
} from "lucide-react";
import {
  BarChart,
  Bar,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  ResponsiveContainer,
  AreaChart,
  Area,
  LineChart,
  Line,
  Legend,
} from "recharts";
import {
  attendanceTrends,
  gradeDistribution,
  performanceByBranch,
  initialAnnouncements,
} from "../data";
import { Student, Teacher, Course, Announcement, Classroom } from "../types";
import { compareClassroomNames } from "../utils/classroomSort";
import ExecutiveDashboardHero from "./dashboard/ExecutiveDashboardHero";
import RoleBasedDashboardPortal from "./dashboard/RoleBasedDashboardPortal";
import type { CloudRole } from "../core/auth";
import type { PanelUser } from "../lib/accessControl";
import { teacherService } from "../modules/teacher";

import { sqliteStorage } from "../core/state/SyncStateStore";
import { LessonCountdownWidget, ActiveScheduleStatusWidget, exportCardAsJPEG } from "./dashboard/DashboardLiveWidgets";

interface DashboardProps {
  stats: any;
  students: Student[];
  teachers: Teacher[];
  courses: Course[];
  classrooms: Classroom[];
  setActiveTab: (tab: any) => void;
  setTeachers: React.Dispatch<React.SetStateAction<Teacher[]>>;
  announcements: Announcement[];
  setAnnouncements: React.Dispatch<React.SetStateAction<Announcement[]>>;
  currentUser?: PanelUser;
}
export default function Dashboard({
  stats,
  students,
  teachers,
  courses,
  classrooms,
  setActiveTab,
  setTeachers,
  announcements,
  setAnnouncements,
  currentUser,
}: DashboardProps) {
  const [tickerDirection, setTickerDirection] = React.useState<"ltr" | "rtl">("ltr");
  const [tickerSpeed, setTickerSpeed] = React.useState<"slow" | "normal" | "fast">("normal");
  const [isTickerPlaying, setIsTickerPlaying] = React.useState(true);
  const [showSettings, setShowSettings] = React.useState(false);
  const [resolvedDashboardRole, setResolvedDashboardRole] = React.useState<CloudRole>(() =>
    currentUser?.role === "super_admin" ? "super_admin" : currentUser?.role === "principal" ? "principal" : "teacher",
  );

  // States for custom rotating widgets
  const [globalTickerIndex, setGlobalTickerIndex] = React.useState(0);
  const [selectedLeaveDates, setSelectedLeaveDates] = React.useState<string[]>([]);
  const [calendarYear, setCalendarYear] = React.useState(() => new Date().getFullYear());
  const [calendarMonth, setCalendarMonth] = React.useState(() => new Date().getMonth());
  const [dutyTickerIndex, setDutyTickerIndex] = React.useState(0);
  const [onLeaveTickerIndex, setOnLeaveTickerIndex] = React.useState(0);
  const [isLeaveModalOpen, setIsLeaveModalOpen] = React.useState(false);
  const [selectedLeaveTeacherId, setSelectedLeaveTeacherId] = React.useState("");
  const [leaveReasonText, setLeaveReasonText] = React.useState("");

  // States for Birthday Modal (Doğum Günü Tebriği)
  const [isBirthdayModalOpen, setIsBirthdayModalOpen] = React.useState(false);
  const [selectedBirthdayStudentId, setSelectedBirthdayStudentId] = React.useState<string | null>(null);
  const [selectedBirthdayCardTheme, setSelectedBirthdayCardTheme] = React.useState<string>("tezhib-gold");
  const [birthdayCustomMessage, setBirthdayCustomMessage] = React.useState<string>("");

  // States for Dashboard Announcement Modal
  const [isAnnouncementModalOpen, setIsAnnouncementModalOpen] = React.useState(false);
  const [newAnnTitle, setNewAnnTitle] = React.useState("");
  const [newAnnContent, setNewAnnContent] = React.useState("");
  const [newAnnTag, setNewAnnTag] = React.useState<"Önemli" | "Genel" | "Etkinlik">("Genel");

  const handleAddAnnouncement = () => {
    if (!newAnnTitle.trim() || !newAnnContent.trim()) {
      alert("Lütfen tüm alanları doldurun!");
      return;
    }
    const newAnn: Announcement = {
      id: `ANN-${Math.floor(100 + Math.random() * 900)}`,
      title: newAnnTitle.trim(),
      content: newAnnContent.trim(),
      date: new Date().toISOString().split("T")[0],
      tag: newAnnTag,
    };
    setAnnouncements((prev) => [newAnn, ...prev]);
    setNewAnnTitle("");
    setNewAnnContent("");
    setNewAnnTag("Genel");
    setIsAnnouncementModalOpen(false);
  };

  const handleDeleteAnnouncement = (id: string) => {
    if (window.confirm("Bu duyuruyu silmek istediğinizden emin misiniz?")) {
      setAnnouncements((prev) => prev.filter((ann) => ann.id !== id));
    }
  };

  // Compute some insights from current live states
  const activeCount = students.filter((s) => s.status === "Aktif").length;
  const criticalAbsencesCount = students.filter((s) => Number(s.absences || 0) > 10).length;

  // Custom styled Tooltip for Recharts
  const CustomTooltip = ({ active, payload, label }: any) => {
    if (active && payload && payload.length) {
      return (
        <div className="bg-slate-900 text-white p-3 rounded-xl border border-slate-800 shadow-xl text-xs leading-none">
          <p className="font-bold text-slate-300 mb-1.5">{label}</p>
          {payload.map((p: any, idx: number) => (
            <p key={idx} className="mt-1" style={{ color: p.color || p.fill }}>
              {p.name}:{" "}
              <span className="font-mono font-bold text-white">{p.value}%</span>
            </p>
          ))}
        </div>
      );
    }
    return null;
  };

  // State for Duty Assignments (Nöbetçi Öğretmenler)
  const [dutyAssignments, setDutyAssignments] = React.useState<any[]>(() => {
    try {
      const saved = sqliteStorage.getItem("school_duty_assignments_v1");
      if (saved) return JSON.parse(saved);
    } catch (e) {
      console.error(e);
    }
    return [
      { id: "duty-1", day: "Pazartesi", location: "Bahçe Nöbeti", teacherName: "Ahmet Yılmaz" },
      { id: "duty-2", day: "Pazartesi", location: "Zemin Kat & Kantin", teacherName: "Ayşe Demir" },
      { id: "duty-3", day: "Salı", location: "1. Kat Koridor", teacherName: "Mehmet Kaya" },
      { id: "duty-4", day: "Salı", location: "Bahçe Nöbeti", teacherName: "Fatma Şahin" },
      { id: "duty-5", day: "Çarşamba", location: "2. Kat Koridor", teacherName: "Mustafa Çelik" },
      { id: "duty-6", day: "Çarşamba", location: "Zemin Kat & Giriş", teacherName: "Zeynep Öztürk" },
      { id: "duty-7", day: "Perşembe", location: "Bahçe Nöbeti", teacherName: "Ali Yıldız" },
      { id: "duty-8", day: "Perşembe", location: "1. Kat Koridor", teacherName: "Elif Arslan" },
      { id: "duty-9", day: "Cuma", location: "Bahçe Nöbeti", teacherName: "Murat Aydın" },
      { id: "duty-10", day: "Cuma", location: "Zemin Kat & Kantin", teacherName: "Seda Yıldırım" },
    ];
  });

  // Sync / Load from localforage
  React.useEffect(() => {
    async function loadDuties() {
      try {
        const lf = (await import("../core/state/AppStateService")).default;
        const saved = await lf.getItem<any[]>("school_duty_assignments_v1");
        if (saved && Array.isArray(saved)) {
          setDutyAssignments(saved);
        }
      } catch (e) {
        console.error("Dashboard failed to load duty assignments", e);
      }
    }
    loadDuties();
  }, []);

  const [showDutyModal, setShowDutyModal] = React.useState(false);
  const [newDutyDay, setNewDutyDay] = React.useState<string>("Pazartesi");
  const [newDutyLocation, setNewDutyLocation] = React.useState<string>("");
  const [newDutyTeacherName, setNewDutyTeacherName] = React.useState<string>("");

  // Save duty assignments to sqliteStorage helper
  const saveDuties = (updated: any[]) => {
    setDutyAssignments(updated);
    try {
      sqliteStorage.setItem("school_duty_assignments_v1", JSON.stringify(updated));
    } catch (e) {
      console.error(e);
    }
  };

  // Grouped duties list for 5-second slide ticker
  const groupedDuties = React.useMemo(() => {
    const groups: Record<string, { day: string; location: string; teachers: string[] }> = {};
    dutyAssignments.forEach((a) => {
      if (!a.day || !a.location) return;
      const key = `${a.day}_${a.location}`;
      if (!groups[key]) {
        groups[key] = { day: a.day, location: a.location, teachers: [] };
      }
      if (a.teacherName && !groups[key].teachers.includes(a.teacherName)) {
        groups[key].teachers.push(a.teacherName);
      }
    });
    return Object.values(groups);
  }, [dutyAssignments]);

  // 1. Get on-leave teachers
  const onLeaveTeachers = React.useMemo(() => {
    return teachers.filter((t) => t.status === "İzinli");
  }, [teachers]);

  // Tickers interval
  React.useEffect(() => {
    if (groupedDuties.length <= 1) {
      setDutyTickerIndex(0);
      return;
    }
    const timer = setInterval(() => {
      setDutyTickerIndex((prev) => (prev + 1) % groupedDuties.length);
    }, 5000);
    return () => clearInterval(timer);
  }, [groupedDuties]);

  React.useEffect(() => {
    if (onLeaveTeachers.length <= 1) {
      setOnLeaveTickerIndex(0);
      return;
    }
    const timer = setInterval(() => {
      setOnLeaveTickerIndex((prev) => (prev + 1) % onLeaveTeachers.length);
    }, 5000);
    return () => clearInterval(timer);
  }, [onLeaveTeachers]);

  // Synchronized global ticker interval (10 seconds)
  React.useEffect(() => {
    const timer = setInterval(() => {
      setGlobalTickerIndex((prev) => prev + 1);
    }, 10000);
    return () => clearInterval(timer);
  }, []);

  // Turkish date formatter helper
  const formatTurkishDate = (dStr: string) => {
    if (!dStr) return "";
    const parts = dStr.split("-");
    if (parts.length !== 3) return dStr;
    const year = parts[0];
    const month = parseInt(parts[1]) - 1;
    const day = parseInt(parts[2]);
    const months = [
      "Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran",
      "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık"
    ];
    return `${day} ${months[month]}`;
  };

  // Handle saving teacher on-leave reason and dates
  const handleSaveLeave = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!selectedLeaveTeacherId) {
      alert("Lütfen bir öğretmen seçin.");
      return;
    }
    const selectedTeacher = teachers.find(t => t.id === selectedLeaveTeacherId);
    if (!selectedTeacher) return;

    if (!setTeachers) {
      alert("Öğretmen verisi güncellenemedi.");
      return;
    }

    try {
      const updatedTeacher = await teacherService.updateTeacher(selectedTeacher.id, {
        ...selectedTeacher,
        status: "İzinli",
        leaveReason: leaveReasonText,
        leaveDates: selectedLeaveDates,
      });
      setTeachers((prev) => prev.map((teacher) => teacher.id === selectedTeacher.id ? updatedTeacher : teacher));
      alert(`${selectedTeacher.name} isimli öğretmen başarıyla izinli olarak işaretlendi.`);
      setIsLeaveModalOpen(false);
      setLeaveReasonText("");
      setSelectedLeaveTeacherId("");
      setSelectedLeaveDates([]);
    } catch (error) {
      alert(error instanceof Error ? error.message : "Öğretmen izin bilgisi kaydedilemedi.");
    }
  };

  const handleRemoveLeave = async () => {
    if (!selectedLeaveTeacherId) return;
    const selectedTeacher = teachers.find(t => t.id === selectedLeaveTeacherId);
    if (!selectedTeacher || !setTeachers) return;

    try {
      const updatedTeacher = await teacherService.updateTeacher(selectedTeacher.id, {
        ...selectedTeacher,
        status: "Aktif",
        leaveReason: undefined,
        leaveDates: undefined,
      });
      setTeachers((prev) => prev.map((teacher) => teacher.id === selectedTeacher.id ? updatedTeacher : teacher));
      alert(`${selectedTeacher.name} tekrar aktif duruma getirildi.`);
      setIsLeaveModalOpen(false);
      setLeaveReasonText("");
      setSelectedLeaveTeacherId("");
      setSelectedLeaveDates([]);
    } catch (error) {
      alert(error instanceof Error ? error.message : "Öğretmen izin bilgisi güncellenemedi.");
    }
  };

  const selectedTeacherObj = teachers.find(t => t.id === selectedLeaveTeacherId);
  const isSelectedTeacherOnLeave = selectedTeacherObj?.status === "İzinli";

  // Pre-populate reason and dates if selected teacher is already on leave
  React.useEffect(() => {
    if (selectedTeacherObj) {
      setLeaveReasonText(selectedTeacherObj.leaveReason || "");
      setSelectedLeaveDates(selectedTeacherObj.leaveDates || []);
    } else {
      setLeaveReasonText("");
      setSelectedLeaveDates([]);
    }
  }, [selectedLeaveTeacherId, selectedTeacherObj]);

  // 2. Get high-achieving "Örnek Öğrenciler" (Model Students list for rotating spotlight)
  const featuredStudents = React.useMemo(() => {
    if (!students || students.length === 0) return [];
    const activeWithGpa = students.filter(s => s.status === "Aktif" && s.gpa !== undefined && s.gpa > 0);
    if (activeWithGpa.length > 0) {
      // Sort descending by GPA
      return [...activeWithGpa].sort((a, b) => (b.gpa || 0) - (a.gpa || 0)).slice(0, 5);
    }
    return students.slice(0, 5);
  }, [students]);

  const featuredStudent = featuredStudents[0] || null;

  // 3. Get student birthdays parsing DOB or generating fallback beautiful ones
  const allStudentBirthdays = React.useMemo(() => {
    const monthsTr = ["Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran", "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık"];
    
    // Filter real students who have dob
    const withDob = students.filter(s => s.dob && s.dob.trim() !== "");
    if (withDob.length === 0) return [];

    const today = new Date();
    const todayYear = today.getFullYear();
    const todayMonth = today.getMonth();
    const todayDate = today.getDate();

    return withDob.map(s => {
      const cleanDob = s.dob!.trim();
      let bYear = 2010;
      let bMonth = 0;
      let bDay = 1;
      
      if (cleanDob.includes('.')) {
        const parts = cleanDob.split('.');
        bDay = parseInt(parts[0]) || 1;
        bMonth = (parseInt(parts[1]) || 1) - 1;
        const y = parseInt(parts[2]) || 2010;
        bYear = y < 100 ? (y > 26 ? 1900 + y : 2000 + y) : y;
      } else if (cleanDob.includes('/')) {
        const parts = cleanDob.split('/');
        bDay = parseInt(parts[0]) || 1;
        bMonth = (parseInt(parts[1]) || 1) - 1;
        const y = parseInt(parts[2]) || 2010;
        bYear = y < 100 ? (y > 26 ? 1900 + y : 2000 + y) : y;
      } else if (cleanDob.includes('-')) {
        const parts = cleanDob.split('-');
        if (parts[0].length === 4) {
          bYear = parseInt(parts[0]) || 2010;
          bMonth = (parseInt(parts[1]) || 1) - 1;
          bDay = parseInt(parts[2]) || 1;
        } else {
          bDay = parseInt(parts[0]) || 1;
          bMonth = (parseInt(parts[1]) || 1) - 1;
          const y = parseInt(parts[2]) || 2010;
          bYear = y < 100 ? (y > 26 ? 1900 + y : 2000 + y) : y;
        }
      }

      const age = todayYear - bYear;
      
      let nextBday = new Date(todayYear, bMonth, bDay);
      if (nextBday < new Date(todayYear, todayMonth, todayDate)) {
        nextBday = new Date(todayYear + 1, bMonth, bDay);
      }
      
      const diffTime = nextBday.getTime() - today.getTime();
      const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

      let label = `${bDay} ${monthsTr[bMonth]}`;
      if (bMonth === todayMonth && bDay === todayDate) {
        label = "Bugün ğŸ‰";
      } else if (diffDays === 1) {
        label = "Yarın ğŸ‚";
      }

      return {
        name: s.name,
        date: label,
        age,
        classroom: s.classroom,
        avatar: s.avatar,
        daysUntilNext: diffDays,
        id: s.id,
        parentName: s.parentName,
        phone: s.phone,
        parentPhone: s.parentPhone
      };
    }).sort((a, b) => a.daysUntilNext - b.daysUntilNext);
  }, [students]);

  const studentBirthdays = React.useMemo(() => allStudentBirthdays.slice(0, 5), [allStudentBirthdays]);
  const todaysBirthdays = React.useMemo(() => allStudentBirthdays.filter(b => b.daysUntilNext === 0), [allStudentBirthdays]);


  // Synchronize birthday custom message template when selected student changes
  React.useEffect(() => {
    if (isBirthdayModalOpen && todaysBirthdays.length > 0) {
      setBirthdayCustomMessage(`Sevgili, {isim}\n\nBugün {yas}. doğum gününü en içten dileklerimizle kutluyoruz! Bu yeni yaşında da hayallerinin peşinden cesaretle koş. Hayallerine doğru attığın her adımda seni destekliyor, başarılarının artarak devam etmesini diliyoruz. Yeni yaşın sana ve ailene mutluluk, sağlık getirsin.`);




    }
  }, [isBirthdayModalOpen, todaysBirthdays]);


  return (
    <div id="dashboard-tab" className="p-6 lg:p-8 max-w-7xl mx-auto space-y-6">

      {/* Main KPI Stat Cards Grid (Four distinct cards) at the very top */}
      <div
        id="stats-grid"
        className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6"
      >
        {/* Card 1: Öğretmen Nöbet Bilgileri (Orange background, rotates 10s if multiple) */}
        <div
          id="stat-students"
          className="bg-orange-50 border border-orange-200/80 rounded-2xl p-6 shadow-sm hover:shadow-md hover:border-orange-300 transition-all group relative overflow-hidden flex flex-col justify-between h-[180px]"
        >
          <div className="flex-1 flex flex-col justify-between">
            <div className="flex items-center justify-between">
              <span className="text-xs font-black text-orange-700 uppercase tracking-wider select-none shrink-0">
                Nöbetçi Öğretmen
              </span>
            </div>

            <div className="mt-2 flex-1 flex flex-col justify-center relative overflow-hidden">
              <AnimatePresence mode="wait">
                {groupedDuties.length > 0 ? (
                  (() => {
                    const currentDuty = groupedDuties[globalTickerIndex % groupedDuties.length];
                    return (
                      <motion.div
                        key={`duty-ticker-${globalTickerIndex % groupedDuties.length}-${currentDuty.day}-${currentDuty.location}`}
                        variants={{
                          initial: { opacity: 0, y: -16 },
                          animate: { opacity: 1, y: 0 },
                          exit: { opacity: 0, y: 16 }
                        }}
                        initial="initial"
                        animate="animate"
                        exit="exit"
                        transition={{ duration: 0.4 }}
                        className="absolute inset-0 flex flex-col items-center justify-center text-center w-full"
                      >
                        <h4 className="text-sm font-extrabold text-slate-800 truncate leading-snug w-full text-center">
                          {currentDuty.teachers.join(" & ")}
                        </h4>
                        <p className="text-[11px] text-slate-500 font-bold block truncate w-full text-center mt-1">
                          {currentDuty.day} - {currentDuty.location}
                        </p>
                      </motion.div>
                    );
                  })()
                ) : (
                  <motion.div
                    key="duty-empty"
                    className="absolute inset-0 flex flex-col items-center justify-center text-center text-slate-400 italic text-xs font-bold w-full"
                  >
                    Sistemde nöbet ataması bulunamadı.
                  </motion.div>
                )}
              </AnimatePresence>
            </div>
          </div>
        </div>

        {/* Card 2: İzinli Öğretmenler Bilgisi (Blue background, rotates 10s if multiple) */}
        <div
          id="stat-teachers"
          className="bg-blue-50 border border-blue-200/80 rounded-2xl p-6 shadow-sm hover:shadow-md hover:border-blue-300 transition-all group relative overflow-hidden flex flex-col justify-between h-[180px]"
        >
          <div className="flex-1 flex flex-col justify-between">
            <div className="flex items-center justify-between">
              <span className="text-xs font-black text-blue-700 uppercase tracking-wider select-none shrink-0">
                İzinli Öğretmen
              </span>
              
              <div className="flex items-center gap-2 shrink-0">
                <span className={`text-[11px] font-bold px-2.5 py-0.5 rounded-full border ${onLeaveTeachers.length > 0 ? "text-amber-700 bg-amber-100 border-amber-200 animate-pulse" : "text-blue-700 bg-blue-100 border-blue-200"}`}>
                  {onLeaveTeachers.length > 0 ? `${onLeaveTeachers.length} İzinli` : "Tam Kadro"}
                </span>
                
                {/* Tiny Circular Button on top right */}
                <button
                  type="button"
                  onClick={(e) => {
                    e.stopPropagation();
                    setIsLeaveModalOpen(true);
                  }}
                  className="w-6 h-6 rounded-full bg-blue-100 hover:bg-blue-200 border border-blue-200 text-blue-600 transition-all flex items-center justify-center shadow-sm cursor-pointer active:scale-90"
                  title="Yeni İzin Kaydet"
                >
                  <Plus className="w-3.5 h-3.5" />
                </button>
              </div>
            </div>

            <div className="mt-2 flex-1 flex flex-col justify-center relative overflow-hidden">
              <AnimatePresence mode="wait">
                {onLeaveTeachers.length > 0 ? (
                  (() => {
                    const currentTeacher = onLeaveTeachers[globalTickerIndex % onLeaveTeachers.length];
                    return (
                      <motion.div
                        key={`leave-ticker-${globalTickerIndex % onLeaveTeachers.length}-${currentTeacher.id}`}
                        variants={{
                          initial: { opacity: 0, y: 16 },
                          animate: { opacity: 1, y: 0 },
                          exit: { opacity: 0, y: -16 }
                        }}
                        initial="initial"
                        animate="animate"
                        exit="exit"
                        transition={{ duration: 0.4 }}
                        className="absolute inset-0 flex flex-col items-center justify-center text-center w-full"
                      >
                        <h4 className="text-sm font-extrabold text-slate-800 tracking-tight leading-snug truncate w-full text-center">
                          {currentTeacher.name}
                        </h4>
                        <p className="text-[11px] text-slate-500 font-bold block truncate w-full text-center mt-1">
                          {currentTeacher.branch}
                        </p>
                        {currentTeacher.leaveDates && currentTeacher.leaveDates.length > 0 && (
                          <p className="text-[9px] text-blue-700 font-black leading-none truncate mt-1.5 w-full text-center">
                            {currentTeacher.leaveDates.map(formatTurkishDate).join(", ")}
                          </p>
                        )}
                      </motion.div>
                    );
                  })()
                ) : (
                  <motion.div
                    key="leave-empty"
                    className="absolute inset-0 flex flex-col items-center justify-center text-center w-full"
                  >
                    <p className="text-xs text-blue-700 font-bold flex items-center justify-center gap-1">
                      <Check className="w-3.5 h-3.5" /> Tüm öğretmenler görevinin başında.
                    </p>
                  </motion.div>
                )}
              </AnimatePresence>
            </div>
          </div>
        </div>

        {/* Card 3: Örnek Öğrenci Spotlight (Pink background, rotates 10s if multiple) */}
        <div
          id="stat-example-student"
          className="bg-pink-50 border border-pink-200/80 rounded-2xl p-6 shadow-sm hover:shadow-md hover:border-pink-300 transition-all group relative overflow-hidden flex flex-col justify-between h-[180px]"
        >
          <div className="flex-1 flex flex-col justify-between">
            <div className="flex items-center justify-between">
              <span className="text-xs font-black text-pink-700 uppercase tracking-wider select-none shrink-0">
                Örnek Öğrenci
