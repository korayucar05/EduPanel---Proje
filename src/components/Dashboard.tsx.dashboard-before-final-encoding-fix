                          // Adjust firstDayIndex so Monday is 0, Sunday is 6
                          const startOffset = firstDayIndex === 0 ? 6 : firstDayIndex - 1;

                          const daySlots: Array<number | null> = [];
                          for (let i = 0; i < startOffset; i++) {
                            daySlots.push(null);
                          }
                          for (let d = 1; d <= daysInMonth; d++) {
                            daySlots.push(d);
                          }

                          return daySlots.map((dayNum, slotIdx) => {
                            if (dayNum === null) {
                              return <div key={`empty-${slotIdx}`} className="aspect-square" />;
                            }

                            const formattedDateStr = `${calendarYear}-${(calendarMonth + 1).toString().padStart(2, "0")}-${dayNum.toString().padStart(2, "0")}`;
